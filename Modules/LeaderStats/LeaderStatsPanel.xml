<?xml version="1.0" encoding="utf-8"?>
<Context Name="LeaderStatsPanel">

  <!-- Collapse/expand tab 
  <Button ID="TabButton" Anchor="L,B" Offset="40,120" Size="140,32"
          String="Empire" Style="BaseButton" Font="TwCenMT20" />
  -->
  
  <!-- Panel: open by default -->
  <Box ID="Panel" Anchor="L,B" Offset="40,160" Size="330,250"
       Color="10,12,18,90" Hidden="0">
    <Stack ID="Rows" Anchor="C,T" Offset="0,12" StackGrowth="Bottom" Padding="6">

      <Label ID="Title" Anchor="C,T" Font="TwCenMT22"
             ColorSet="Beige_Black_Alpha" FontStyle="Shadow"/>

      <!-- Divider: explicit color so it isn't white -->
      <Box Size="300,1" Color="255,255,255,60"/>

      <!-- Rows use Container (no visuals) instead of Box -->
      <Container Size="300,28">
        <Label Anchor="L,C" String="Military" Font="TwCenMT18" ColorSet="Beige_Black_Alpha"/>
        <Label ID="Army" Anchor="R,C" Font="TwCenMT18" ColorSet="Beige_Black_Alpha"/>
      </Container>
      <Container Size="300,28">
        <Label Anchor="L,C" String="Supply / Power" Font="TwCenMT18" ColorSet="Beige_Black_Alpha"/>
        <Label ID="Supply" Anchor="R,C" Font="TwCenMT18" ColorSet="Beige_Black_Alpha"/>
      </Container>
      <Container Size="300,28">
        <Label Anchor="L,C" String="Gold" Font="TwCenMT18" ColorSet="Beige_Black_Alpha"/>
        <Label ID="Gold" Anchor="R,C" Font="TwCenMT18" ColorSet="Beige_Black_Alpha"/>
      </Container>
      <Container Size="300,28">
        <Label Anchor="L,C" String="Science" Font="TwCenMT18" ColorSet="Beige_Black_Alpha"/>
        <Label ID="Sci" Anchor="R,C" Font="TwCenMT18" ColorSet="Beige_Black_Alpha"/>
      </Container>
      <Container Size="300,28">
        <Label Anchor="L,C" String="Cities / Pop" Font="TwCenMT18" ColorSet="Beige_Black_Alpha"/>
        <Label ID="Cities" Anchor="R,C" Font="TwCenMT18" ColorSet="Beige_Black_Alpha"/>
      </Container>
      <Container Size="300,28">
        <Label Anchor="L,C" String="Ideology" Font="TwCenMT18" ColorSet="Beige_Black_Alpha"/>
        <Label ID="Ideo" Anchor="R,C" Font="TwCenMT18" ColorSet="Beige_Black_Alpha"/>
      </Container>

    </Stack>
  </Box>
</Context>