					<Container Size="190,64">
						<Stack Anchor="L,T" StackGrowth="Down" Padding="8">
							<CheckBox ID="OverlayCommanderCheck" Anchor="L,C" IsChecked="1" TextAnchor="R,C" String="TXT_KEY_GAIA_OVERLAY_COMMANDER" ToolTip="TXT_KEY_GAIA_OVERLAY_COMMANDER_HELP" Style="SquareCheck" Font="TwCenMT18" ColorSet="Beige_Black_Alpha" FontStyle="Base"/>
