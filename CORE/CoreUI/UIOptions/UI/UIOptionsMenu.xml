<!-- User Interface Options -->
<Context>
	<Box Style="BGBlock"/>

	<Grid Size="480,537" Anchor="C,C" Style="Grid9DetailFive140" ConsumeMouse="1">

		<Label Anchor="C,T" Offset="0,15" Font="TwCenMT24" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" String="TXT_KEY_GAIA_UI_OPTIONS_TITLE"/>

		<Stack Anchor="C,T" Offset="0,52" StackGrowth="Down" Padding="12">

			<!-- Promotion Flags + Small Resource Icons -->
			<Container Anchor="C,T" Size="420,30">
				<Stack Anchor="L,T" Offset="20,0" StackGrowth="Right" Padding="15">
					<Container Size="190,30">
						<CheckBox ID="PromotionFlagsCheck" Anchor="L,C" IsChecked="0" TextAnchor="R,C" String="TXT_KEY_GAIA_UI_OPTION_PROMOTION_ICONS" ToolTip="TXT_KEY_GAIA_UI_OPTION_PROMOTION_ICONS_HELP" Style="SquareCheck" Font="TwCenMT20" ColorSet="Beige_Black_Alpha" FontStyle="Shadow"/>
					</Container>
					<Container Size="190,30">
						<CheckBox ID="SmallIconsCheck" Anchor="L,C" IsChecked="0" TextAnchor="R,C" String="TXT_KEY_GAIA_SMALL_RESOURCE_ICONS" ToolTip="TXT_KEY_GAIA_SMALL_RESOURCE_ICONS_HELP" Style="SquareCheck" Font="TwCenMT20" ColorSet="Beige_Black_Alpha" FontStyle="Shadow"/>
					</Container>
				</Stack>
			</Container>

			<!-- Auto End Turn Button -->
			<Container Anchor="C,T" Size="420,30">
				<Stack Anchor="L,T" Offset="20,0" StackGrowth="Right" Padding="15">
					<Container Size="190,30">
						<CheckBox ID="AutoEndTurnButtonCheck" Anchor="L,C" IsChecked="1" TextAnchor="R,C" String="TXT_KEY_GAIA_AUTO_END_TURN_BUTTON" ToolTip="TXT_KEY_GAIA_AUTO_END_TURN_BUTTON_HELP" Style="SquareCheck" Font="TwCenMT20" ColorSet="Beige_Black_Alpha" FontStyle="Shadow"/>
					</Container>
				</Stack>
			</Container>

			<!-- Production Menu -->
			<CheckBox ID="ProductionSortCheck" Anchor="L,C" Offset="20,0" IsChecked="0" TextAnchor="R,C" String="TXT_KEY_GAIA_PRODUCTION_SORT" ToolTip="TXT_KEY_GAIA_PRODUCTION_SORT_HELP" Style="SquareCheck" Font="TwCenMT20" ColorSet="Beige_Black_Alpha" FontStyle="Shadow"/>
			<CheckBox ID="ProductionHideCheck" Anchor="L,C" Offset="20,0" IsChecked="1" TextAnchor="R,C" String="TXT_KEY_GAIA_PRODUCTION_HIDE" ToolTip="TXT_KEY_GAIA_PRODUCTION_HIDE_HELP" Style="SquareCheck" Font="TwCenMT20" ColorSet="Beige_Black_Alpha" FontStyle="Shadow"/>

			<!-- Map Overlays -->
			<CheckBox ID="OverlayMasterCheck" Anchor="L,C" Offset="20,0" IsChecked="0" TextAnchor="R,C" String="TXT_KEY_GAIA_MAP_OVERLAYS" ToolTip="TXT_KEY_GAIA_MAP_OVERLAYS_HELP" Style="SquareCheck" Font="TwCenMT20" ColorSet="Beige_Black_Alpha" FontStyle="Shadow"/>
			<Container Anchor="C,T" Size="420,64">
				<Stack Anchor="L,T" Offset="50,0" StackGrowth="Right" Padding="35">
					<Container Size="140,64">
						<Stack Anchor="L,T" StackGrowth="Down" Padding="8">
							<CheckBox ID="OverlayCityLimitsCheck" Anchor="L,C" IsChecked="1" TextAnchor="R,C" String="TXT_KEY_GAIA_OVERLAY_CITY_LIMITS" ToolTip="TXT_KEY_GAIA_OVERLAY_CITY_LIMITS_HELP" Style="SquareCheck" Font="TwCenMT18" ColorSet="Beige_Black_Alpha" FontStyle="Base"/>
							<CheckBox ID="OverlayDigSitesCheck" Anchor="L,C" IsChecked="1" TextAnchor="R,C" String="TXT_KEY_GAIA_OVERLAY_DIG_SITES" ToolTip="TXT_KEY_GAIA_OVERLAY_DIG_SITES_HELP" Style="SquareCheck" Font="TwCenMT18" ColorSet="Beige_Black_Alpha" FontStyle="Base"/>
