		</Stack>

		<GridButton ID="CloseButton" Size="120,28" Offset="0,20" Anchor="C,B" Style="BaseButton">
			<Label Anchor="C,C" Offset="0,0" String="TXT_KEY_CLOSE" Font="TwCenMT18" FontStyle="Shadow" ColorSet="Beige_Black_Alpha"/>
		</GridButton>

	</Grid>
</Context>
