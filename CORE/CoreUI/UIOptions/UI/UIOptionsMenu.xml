			<CheckBox ID="QuickAnimMasterCheck" Anchor="L,C" Offset="20,0" IsChecked="0" TextAnchor="R,C" String="TXT_KEY_GAIA_QUICK_ANIMATIONS" ToolTip="TXT_KEY_GAIA_QUICK_ANIMATIONS_HELP" Style="SquareCheck" Font="TwCenMT20" ColorSet="Beige_Black_Alpha" FontStyle="Shadow"/>
