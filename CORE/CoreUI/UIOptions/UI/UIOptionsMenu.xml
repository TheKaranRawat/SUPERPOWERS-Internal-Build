							<CheckBox ID="QuickAnimPlayerWarCheck" Anchor="L,C" IsChecked="0" TextAnchor="R,C" String="TXT_KEY_GAIA_FURIOUSTURNS_OPT_PLAYER_WAR" ToolTip="TXT_KEY_GAIA_FURIOUSTURNS_PLAYER_WAR_TOOLTIP" Style="SquareCheck" Font="TwCenMT18" ColorSet="Beige_Black_Alpha" FontStyle="Base"/>
							<CheckBox ID="QuickAnimAIWarCheck" Anchor="L,C" IsChecked="0" TextAnchor="R,C" String="TXT_KEY_GAIA_FURIOUSTURNS_OPT_AI_WAR" ToolTip="TXT_KEY_GAIA_FURIOUSTURNS_AI_WAR_TOOLTIP" Style="SquareCheck" Font="TwCenMT18" ColorSet="Beige_Black_Alpha" FontStyle="Base"/>
						</Stack>
					</Container>
					<Container Size="190,64">
						<Stack Anchor="L,T" StackGrowth="Down" Padding="8">
							<CheckBox ID="QuickAnimPlayerPeaceCheck" Anchor="L,C" IsChecked="1" TextAnchor="R,C" String="TXT_KEY_GAIA_FURIOUSTURNS_OPT_PLAYER_PEACE" ToolTip="TXT_KEY_GAIA_FURIOUSTURNS_PLAYER_PEACE_TOOLTIP" Style="SquareCheck" Font="TwCenMT18" ColorSet="Beige_Black_Alpha" FontStyle="Base"/>
