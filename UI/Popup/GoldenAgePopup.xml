<?xml version="1.0" encoding="utf-8"?>
<Context Font="TwCenMT14" FontStyle="Base" Color="Beige" Color1="Black" >

    <!-- No full-screen BGBlock: the popup is now a non-blocking toast at the top of the screen. -->

    <!--
        SlideAnim: moves the popup down from above the screen (Start) to its resting spot (End).
        Start Y must be at least -(popup height + top margin) so it begins fully off-screen.
        -300 covers heights up to ~250. Raise it if you configure a taller popup.
        Speed: higher = faster slide (Lua only controls how long it holds in between).
    -->
    <SlideAnim ID="SlideAnim" Anchor="C,T" Start="0,-300" End="0,0" Cycle="Once" Speed="4" Pause="0" Stopped="1">

        <!-- AlphaAnim: fades the popup in (and back out when reversed) -->
        <AlphaAnim ID="FadeAnim" Anchor="C,T" AlphaStart="0" AlphaEnd="1" Cycle="Once" Speed="4" Pause="0" Stopped="1">

            <!-- Size and Offset are overwritten from the Lua constants (POPUP_WIDTH / POPUP_HEIGHT / POPUP_TOP_MARGIN) -->
            <Grid ID="MainGrid" Size="380,120" Anchor="C,T" Offset="0,40" Style="Grid9DetailFive140" >

                <!-- Side treatments -->
                <Box Style="MenuLeftSideTreatment"/>
                <Box Style="MenuRightSideTreatment"/>

                <Label Anchor="C,T" Offset="0,10" Font="TwCenMT22" FontStyle="Shadow" Color0="255.221.0.255" Color1="0.0.0.255" Color2="255.255.0.255" String="TXT_KEY_POP_GOLDEN_AGE_BEGIN" ID="TitleLabel"/>

                <Box Size="350,50" Anchor="C,T" Offset="0,38" Color="255,255,255,0" >
                    <Label Anchor="C,T" Offset="0,0" WrapWidth="340" LeadingOffset="-4" Font="TwCenMT16" FontStyle="Shadow" ColorSet="Beige_Black_Alpha" String="" ID="DescriptionLabel" />
                </Box>

                <GridButton Size="90,26" Anchor="C,B" Style="BaseButton" Offset="0,8" ID="CloseButton" Hidden="0">
                    <Label Anchor="C,C" Offset="0,-1" String="TXT_KEY_CLOSE" Color0="255.255.200.255" Color1="0.0.0.128" Color2="255.255.200.255" Font="TwCenMT18" FontStyle="Shadow" />
                </GridButton>

            </Grid>

        </AlphaAnim>
    </SlideAnim>
</Context>